config RESPEAKER_I2S_EXTERNAL_CLOCK_48K
    bool "ReSpeaker: XMOS supplies 48 kHz I2S clocks"
    depends on BOARD_TYPE_SEEED_XIAO_ESP32S3_RESPEAKER_XVF3800
    default n
    help
        Configure the ESP32-S3 as an I2S slave at 48 kHz when the XMOS supplies
        BCLK and WS. Xiaozhi resamples the captured audio to 16 kHz.
        Leave disabled for XMOS I2S slave firmware requiring a 16 kHz host master.
        Select according to the XMOS firmware, not just the microphone shape.

config RESPEAKER_AUDIO_DIAGNOSTICS
    bool "ReSpeaker: log I2S capture statistics and raw samples"
    depends on BOARD_TYPE_SEEED_XIAO_ESP32S3_RESPEAKER_XVF3800
    default n
    help
        Report I2S sample counts, amplitude and raw sample pairs every five
        seconds while capturing. Leave disabled for normal operation.

config RESPEAKER_I2S_CLOCK_PROBE_ONLY
    bool "ReSpeaker: passive I2S clock diagnostic only (no chat)"
    depends on BOARD_TYPE_SEEED_XIAO_ESP32S3_RESPEAKER_XVF3800
    default n
    help
        Leave BCLK and WS as inputs and report observed external clock activity.
        This diagnostic does not initialize I2S or start the Xiaozhi application.
        Disable it and rebuild to restore normal operation.

config RESPEAKER_XVF3800_BARGE_IN
    bool "ReSpeaker: device-side barge-in from the XVF3800 speech-energy readout"
    depends on BOARD_TYPE_SEEED_XIAO_ESP32S3_RESPEAKER_XVF3800
    default n
    help
        Poll AEC_SPENERGY_VALUES over the XVF3800 I2C control interface while
        the device is speaking. The XMOS computes speech energy after its own
        AEC and echo suppression, so during playback a non-zero value means a
        near-end talker, not the loudspeaker. When it stays above
        RESPEAKER_XVF3800_BARGE_IN_THRESHOLD for RESPEAKER_XVF3800_BARGE_IN_HOLD_MS,
        the board drops the local playback queue and sends an abort to the
        server, without waiting for residual echo gating on the server side.

config RESPEAKER_XVF3800_BARGE_IN_THRESHOLD
    string "ReSpeaker: speech energy that counts as near-end speech"
    depends on RESPEAKER_XVF3800_BARGE_IN
    default "1000"
    help
        Compared against the largest of the four AEC_SPENERGY_VALUES (a float).
        The XVF3800 user guide states that any value above 0 indicates speech;
        on a reSpeaker XVF3800 (Seeed I2S firmware v1.0.4) the values are either
        exactly 0 or above about 7e3, so the default only rejects numerical dust.
        RESPEAKER_XVF3800_CONTROL_DIAGNOSTICS logs the values for calibration.

config RESPEAKER_XVF3800_BARGE_IN_INPUT_RMS
    int "ReSpeaker: processed-input RMS (16-bit) that also counts as near-end speech (0 = off)"
    depends on RESPEAKER_XVF3800_BARGE_IN
    range 0 32767
    default 0
    help
        Second vote source. The XMOS output received over I2S is almost silent
        while the loudspeaker plays (about 50 RMS, peaks under 350 in 16-bit
        units over 51 s on a reSpeaker XVF3800 at volume 70), so a sustained
        level above this threshold during playback is a near-end talker even
        when the DSP's speech-energy estimate stays at 0. With PP_DTSENSITIVE 15
        and the AGC frozen at 4, every recorded barge-in carried speech energy,
        while typing next to the board added level votes without any, so the
        reSpeaker XVF3800 config.json leaves this at 0.

config RESPEAKER_XVF3800_BARGE_IN_MIN_RMS
    int "ReSpeaker: a speech-energy vote also needs at least this input RMS (0 = off)"
    range 0 32767
    depends on RESPEAKER_XVF3800_BARGE_IN
    default 150
    help
        The XVF3800 free-running beam is deliberately sensitive and reports
        speech energy on noise and residual echo (single polls of 1e5..1e6
        with the ESP input at 60..120 RMS were seen during quiet playback).
        Requiring the processed input to carry some level at the same time
        rejects those; a real near-end talker reaches hundreds to thousands.

config RESPEAKER_XVF3800_BARGE_IN_LOUDEST_CHUNK
    bool "ReSpeaker: the MIN_RMS check of a speech-energy vote uses the loudest chunk since the previous poll"
    depends on RESPEAKER_XVF3800_BARGE_IN
    default n
    help
        A poll sees the input as one 10 ms chunk in about seven. During playback
        the XMOS double-talk processing chops near-end speech into fragments, so
        on 11-03 polls with speech energy during a stop phrase often found the
        latest chunk between two fragments (26..136 RMS) while the chunks since
        the previous poll reached 400..2700. With this option the check takes
        the louder of the latest chunk and the loudest chunk since the previous
        poll. The fast path still looks at the latest chunk only. It also turns
        stray fragments into votes: on 11-03, replaying the same 10 minutes of
        playback (stories, typing, backchannels, a quiet story) gave 8 false
        interruptions with this option against 2 without it, so the reSpeaker
        XVF3800 config.json leaves it off.

config RESPEAKER_XVF3800_BARGE_IN_STRONG_RMS
    int "ReSpeaker: input RMS (16-bit) that interrupts after only a few polls (0 = off)"
    depends on RESPEAKER_XVF3800_BARGE_IN
    range 0 32767
    default 0
    help
        Fast path next to the speech-poll window. During playback the XMOS
        post-processing chops near-end speech into short bursts, so a talker
        at about a metre can fail to add up RESPEAKER_XVF3800_BARGE_IN_HOLD_MS
        even though the loud part of a word stands well above the residual
        echo. When RESPEAKER_XVF3800_BARGE_IN_STRONG_POLLS polls within
        RESPEAKER_XVF3800_BARGE_IN_STRONG_WINDOW_MS see the processed input
        above this level, the reply is interrupted at once. On a reSpeaker
        XVF3800 at volume 70 with the AGC frozen at 4, single polls of residual
        echo reached 1437 RMS over 100 s of quiet playback and 2774 right after
        a barge-in, while the loud part of a barge-in phrase ran 2000..6700 on
        consecutive polls. A loud poll also needs speech energy above
        RESPEAKER_XVF3800_BARGE_IN_THRESHOLD: typing on a keyboard next to the
        board gave consecutive polls above 2000 RMS with all four energies at 0,
        while every recorded barge-in carried energy on its loud polls.

config RESPEAKER_XVF3800_BARGE_IN_STRONG_POLLS
    int "ReSpeaker: polls above STRONG_RMS that trigger the fast path"
    depends on RESPEAKER_XVF3800_BARGE_IN
    range 1 64
    default 2
    help
        Counted over RESPEAKER_XVF3800_BARGE_IN_STRONG_WINDOW_MS (the speech
        window when that is 0) and capped at its length. One poll is enough to
        be cut by a knock on the table.

config RESPEAKER_XVF3800_BARGE_IN_STRONG_WINDOW_MS
    int "ReSpeaker: window for the fast path's loud polls (ms, 0 = same as the speech window)"
    depends on RESPEAKER_XVF3800_BARGE_IN
    range 0 4000
    default 0
    help
        On a reSpeaker XVF3800 a knock on the table showed up as one loud poll
        that had decayed below 2000 RMS by the next poll, and two knocks 0.8 s
        apart both fell inside the 600 ms (12-poll) speech window. The loud
        part of a spoken word spanned consecutive polls in every recorded
        barge-in, so a window of a few polls keeps the fast path for speech
        while isolated knocks no longer add up.

config RESPEAKER_XVF3800_BARGE_IN_DUCK
    bool "ReSpeaker: the fast path lowers the volume instead of interrupting"
    depends on RESPEAKER_XVF3800_BARGE_IN
    default n
    help
        Loudness does not tell an interruption from a backchannel. On a
        reSpeaker XVF3800 a listener's one-syllable "en" (3811 and 4313 RMS on
        consecutive polls) and a synthetic "dui dui" (2847, 2651) looked like
        the start of a synthetic "xiao zhi, stop" (2302..7244), and the
        backchannels were over after about 430 ms while the first word of the
        command lasted 430..580 ms before a pause. With this option the fast
        path only ducks the playback to RESPEAKER_XVF3800_BARGE_IN_DUCK_PERCENT;
        the reply is interrupted once the speech window fills or the ducked
        burst adds up RESPEAKER_XVF3800_BARGE_IN_DUCK_CONFIRM_POLLS speech
        polls, and the volume comes back when the burst ends first.

config RESPEAKER_XVF3800_BARGE_IN_DUCK_PERCENT
    int "ReSpeaker: playback amplitude while ducked (percent of normal)"
    depends on RESPEAKER_XVF3800_BARGE_IN_DUCK
    range 0 100
    default 25
    help
        Applied to the samples sent to the XVF3800, which plays them and also
        uses them as its echo reference, so the echo canceller only sees a gain
        change. The change is ramped over one DMA chunk (15 ms at 16 kHz) and
        reaches the loudspeaker behind the queued DMA audio (90 ms) and the
        frame being written (up to 60 ms).

config RESPEAKER_XVF3800_BARGE_IN_DUCK_SPEECH_POLLS
    int "ReSpeaker: speech polls among the fast path's last polls that also duck the reply (0 = loud polls only)"
    depends on RESPEAKER_XVF3800_BARGE_IN_DUCK
    range 0 64
    default 0
    help
        The fast path only ducks on polls above RESPEAKER_XVF3800_BARGE_IN_STRONG_RMS,
        which a soft talker never reaches during playback. With this option the
        reply is also ducked once this many of the last
        RESPEAKER_XVF3800_BARGE_IN_STRONG_WINDOW_MS polls are speech polls: less
        echo reaches the XMOS while the talker goes on, so its double-talk
        processing chops less of the rest of the phrase. Typing next to the board
        ducks more often as well (it never interrupts by itself, see
        RESPEAKER_XVF3800_BARGE_IN_VOICED_POLLS). Replaying the polls of 11-03
        with the XMOS at its factory post-processing values, 2 of 4 caught none
        of the soft stop phrases (Mac at volume 8) that went undetected during
        a story, so the reSpeaker XVF3800 config.json leaves it at 0.

config RESPEAKER_XVF3800_BARGE_IN_DUCK_CONFIRM_POLLS
    int "ReSpeaker: speech polls in a ducked burst that interrupt the reply (0 = speech window only)"
    depends on RESPEAKER_XVF3800_BARGE_IN_DUCK
    range 0 64
    default 8
    help
        Counted from the first speech poll of the burst, so the polls before
        the duck count too, and across gaps shorter than
        RESPEAKER_XVF3800_BARGE_IN_DUCK_RELEASE_MS, so the pause after the
        first word of a command does not start the count again.

config RESPEAKER_XVF3800_BARGE_IN_DUCK_RELEASE_MS
    int "ReSpeaker: a ducked burst ends after this long without a speech poll (ms)"
    depends on RESPEAKER_XVF3800_BARGE_IN_DUCK
    range 100 2000
    default 400
    help
        Measured in real time, not in polls. Longer than the pause after
        "xiao zhi," in a synthetic stop phrase (about 290 ms), so the command
        stays one burst; when a burst ends without interrupting, the volume
        ramps back. During continuous playback the XMOS double-talk processing
        also drops the speech polls next to that pause: on 11-03 the last
        speech poll of "xiao zhi" and the first of "stop" were 420..480 ms
        apart while a story played, so with 400 the count started again and
        the reply was interrupted about 1.5 s after the onset. The reSpeaker
        XVF3800 config.json uses 500: replaying four recorded sessions, 500
        caught the same stop phrases as 600 with one false interruption fewer
        (a longer gap also merges stray echo votes into one burst), while 400
        missed one per session. A reply segment that ends within this time of the last
        speech poll does not end the burst: the next segment is counted
        without RESPEAKER_XVF3800_BARGE_IN_GRACE_MS (a stop phrase that began
        in the gap between two GPT-Live segments lost four loud polls to the
        grace period and was cut 1.3 s after its onset) and starts ducked if
        the burst was ducked.

config RESPEAKER_XVF3800_BARGE_IN_TRACE
    bool "ReSpeaker: log every barge-in poll while speaking (evaluation only)"
    depends on RESPEAKER_XVF3800_BARGE_IN
    default n
    help
        One short line per poll with the time since the reply started, the
        processed-input RMS and the largest speech energy, so that a recorded
        test session can be replayed offline against other vote rules. About
        20 lines per second during playback; keep it off in normal builds.
        The line also describes every input chunk since the previous poll
        (polls see one 10 ms chunk in about seven): their number, RMS, the
        loudest chunk, chunks of at least RESPEAKER_XVF3800_BARGE_IN_MIN_RMS,
        the largest sample, the difference energy over the energy (percent;
        mostly single digits for speech, 200 for white noise), sign changes
        per 1000 samples and, on speech polls, the voicing of
        RESPEAKER_XVF3800_BARGE_IN_VOICING (percent) and the microseconds it
        took.

config RESPEAKER_XVF3800_BARGE_IN_VOICED_POLLS
    int "ReSpeaker: voiced polls an interruption needs in the speech window (0 = off)"
    depends on RESPEAKER_XVF3800_BARGE_IN
    range 0 64
    default 0
    help
        The XVF3800 reports speech energy on keystrokes as well: on 11-03,
        typing next to a reSpeaker XVF3800 filled the speech window during
        playback and interrupted replies while nobody spoke, at least four
        times in five minutes, at input levels as high as a spoken command's.
        Each speech poll also
        measures how periodic its input is (RESPEAKER_XVF3800_BARGE_IN_VOICING),
        and both the speech window and a ducked burst interrupt the reply only
        once this many of the polls in the speech window are voiced; the fast
        path still ducks without it. This buys margin, not a clean split: that
        keyboard rings at about 170 Hz for up to 100 ms after a keystroke,
        which scored 0.27..0.79 against 0.37..0.91 for a stop phrase spoken
        during playback (the XMOS double-talk processing chops near-end
        speech). Replaying recordings with 2 polls at 0.75, 22 s of that
        typing no longer interrupted the reply (4 times with this option off)
        and the stop phrase still interrupted at the same poll. Tune both
        values again for another keyboard or room.

config RESPEAKER_XVF3800_BARGE_IN_VOICING
    string "ReSpeaker: periodicity that makes a speech poll voiced"
    depends on RESPEAKER_XVF3800_BARGE_IN
    default "0.75"
    help
        Largest r(lag) / r(0) over the input since the previous poll and the
        20 ms before it, in 32 ms frames stepping back from the newest sample
        by 16 ms, for lags of 2..12.5 ms (pitch 80..500 Hz); r(lag) sums over
        the frame's overlap with itself, so a sound that dies away within the
        lag scores low. Computed on speech polls only: on the reSpeaker
        XVF3800 (size-optimised build) about 5 ms per speech poll, at most
        9 ms, and the poll interval during playback stayed at about 70 ms.

config RESPEAKER_XVF3800_BARGE_IN_LOG_ONLY
    bool "ReSpeaker: log barge-in decisions without interrupting (evaluation only)"
    depends on RESPEAKER_XVF3800_BARGE_IN
    default n
    help
        When the votes add up, the decision is logged, the count starts again
        and the reply keeps playing (the fast path still ducks it). Used to
        record a long stretch of a noise source next to the board during
        playback, for example typing, and replay it offline.

config RESPEAKER_XVF3800_TUNE_UDP_PORT
    int "ReSpeaker: UDP port for live XVF3800 tuning commands (0 = off, evaluation only)"
    depends on RESPEAKER_XVF3800_BARGE_IN
    range 0 65535
    default 0
    help
        Listens on this port for one-line commands from the local network and
        logs the result: "r <resid> <cmd> <f|i|u>[count]" reads a control
        parameter (float, int32 or uint8), "w <resid> <cmd> <f|i|u> <v1> [v2]
        [v3]" writes up to three values and reads them back (PP_MGSCALE,
        resource 17 / command 29, is three floats; "w 48 7 u 1" reboots the
        XMOS, which then needs the boot-time overrides again), and "duck <n>" sets
        RESPEAKER_XVF3800_BARGE_IN_DUCK_SPEECH_POLLS. Anyone on
        the network can change the DSP, so keep it at 0 outside test builds.
        Written XMOS values stay until the XMOS is power-cycled or rebooted.

config RESPEAKER_XVF3800_ECHO_GUARD
    bool "ReSpeaker: reboot the XMOS when replies keep starting with near-full-scale echo"
    depends on RESPEAKER_XVF3800_BARGE_IN
    default n
    help
        On a reSpeaker XVF3800 one near-full-scale input during playback left the
        XMOS echo canceller diverged: every later reply started at 19k..25k RMS,
        the server took the device's own voice for the user and cut each reply
        within a second, so the canceller never reconverged. Resetting the ESP
        does not reset the XMOS; only a power cycle did. With this option, when
        RESPEAKER_XVF3800_ECHO_GUARD_REPLIES replies in a row carry input above
        RESPEAKER_XVF3800_ECHO_GUARD_RMS on two polls within their first 800 ms,
        the XMOS is rebooted over I2C (REBOOT, resid 48 / cmd 7) once the reply
        has ended, and the boot-time overrides are written again.

config RESPEAKER_XVF3800_ECHO_GUARD_RMS
    int "ReSpeaker: input RMS at the start of a reply that counts as runaway echo"
    depends on RESPEAKER_XVF3800_ECHO_GUARD
    range 1 32767
    default 8000
    help
        Healthy replies started below 500 RMS and barge-ins at the start of a
        reply stayed under 6000; every reply of the diverged state had at least
        two polls above 12000 in its first 800 ms.

config RESPEAKER_XVF3800_ECHO_GUARD_REPLIES
    int "ReSpeaker: replies in a row that must start that loud"
    depends on RESPEAKER_XVF3800_ECHO_GUARD
    range 1 10
    default 2

config RESPEAKER_XVF3800_BARGE_IN_HOLD_MS
    int "ReSpeaker: near-end speech must add up to this long (ms)"
    depends on RESPEAKER_XVF3800_BARGE_IN
    range 50 2000
    default 300
    help
        Polls that report speech are counted over a sliding window of
        RESPEAKER_XVF3800_BARGE_IN_WINDOW_MS; the reply is interrupted once
        they add up to this long. Speech energy flickers within a phrase, and
        residual echo produced isolated blips of at most about 200 ms during
        51 s of playback, so a window rather than a consecutive run is used.
        The reSpeaker XVF3800 config.json uses 400 (8 of 12 polls): the ringing
        of two quick knocks on the table filled 6 polls with speech energy,
        while every recorded barge-in was caught by the fast path first.

config RESPEAKER_XVF3800_BARGE_IN_WINDOW_MS
    int "ReSpeaker: sliding window for counting speech polls (ms)"
    depends on RESPEAKER_XVF3800_BARGE_IN
    range 100 4000
    default 600

config RESPEAKER_XVF3800_BARGE_IN_GRACE_MS
    int "ReSpeaker: ignore the first milliseconds of each reply"
    depends on RESPEAKER_XVF3800_BARGE_IN
    range 0 2000
    default 300
    help
        Speech energy is not evaluated during this window after the device
        enters the speaking state, so the start of a reply cannot be cut by a
        transient.

config RESPEAKER_XVF3800_PP_DTSENSITIVE
    int "ReSpeaker: PP_DTSENSITIVE to write at boot (-1 = do not write)"
    depends on RESPEAKER_XVF3800_BARGE_IN || RESPEAKER_XVF3800_CONTROL_DIAGNOSTICS
    range -1 15
    default 0
    help
        XVF3800 double-talk sensitivity (resource 17, command 31; XMOS and
        Seeed default 0). 0 prefers echo suppression and mutes most near-end
        speech while the loudspeaker plays; 10..15 add a near-end speech
        detector and prefer double-talk. On a reSpeaker XVF3800 (Seeed I2S
        firmware v1.0.4, speaker at volume 70) a talker at 0.5..1 m did not
        reach the ESP32 at all during playback with 0 or 10 (input stayed at
        60..80 RMS, speech energy 0); 15 together with a fixed AGC gain let
        the same speech through at thousands of RMS while the playback floor
        stayed near 25 RMS in a quiet room. Room speech then interrupts too.
        The XMOS keeps the last written value until it is power-cycled (an
        ESP32 reset alone does not clear it), so the value is written
        explicitly at every boot to make the state deterministic.

config RESPEAKER_XVF3800_PP_FMIN_SPEINDEX
    string "ReSpeaker: PP_FMIN_SPEINDEX (Hz) to write at boot (empty = leave the XMOS default)"
    depends on RESPEAKER_XVF3800_BARGE_IN || RESPEAKER_XVF3800_CONTROL_DIAGNOSTICS
    default ""
    help
        Below this frequency the XVF3800 suppresses near-end speech harder during
        double-talk (resource 17, command 30, float, XMOS default 593.75; the
        Seeed firmware ships 1300). Re-sent at every boot. An empty value does
        not undo a value written earlier: the XMOS keeps it until power-cycled.
        On 11-03 the XMOS default (593.75) let residual echo through during a
        story (65 speech polls and 2 interruptions in 20 s of quiet playback)
        without making a soft stop phrase detectable.

config RESPEAKER_XVF3800_PP_MGSCALE
    string "ReSpeaker: PP_MGSCALE (\"max min\") to write at boot (empty = leave the XMOS value)"
    depends on RESPEAKER_XVF3800_BARGE_IN || RESPEAKER_XVF3800_CONTROL_DIAGNOSTICS
    default ""
    help
        Extra noise suppression the XVF3800 applies while the far end (the
        loudspeaker) is active (resource 17, command 29, three floats: max, min,
        in use). The XMOS tuning guide starts from 1 1 1 and raises max (typical
        100..1000, min equal to max) until the residual echo stops improving;
        more suppression also removes more near-end speech during playback.
        Re-sent at every boot; the value in use is written equal to min. The
        Seeed I2S firmware v1.0.4 ships 1000 1 1. On 11-03, max 100 or 1 let
        residual echo through during a story (19 and 41 speech polls in 20 s of
        quiet playback, against none) and still did not make a soft stop phrase
        (Mac at volume 8) detectable, so the reSpeaker XVF3800 leaves it alone.

config RESPEAKER_XVF3800_PP_AGC_FIXED_GAIN
    string "ReSpeaker: freeze the XVF3800 AGC at this gain (empty = leave the AGC adaptive)"
    depends on RESPEAKER_XVF3800_BARGE_IN || RESPEAKER_XVF3800_CONTROL_DIAGNOSTICS
    default ""
    help
        Writes PP_AGCGAIN (resource 17, command 13, linear factor) and then
        PP_AGCONOFF = 0 at boot. The adaptive AGC drops its gain to about 1.5
        while the loudspeaker plays (it measures the beam power, echo included)
        and climbs to 10..17 in silence, so near-end speech during playback
        reaches the ESP32 several times quieter than the same speech in
        silence. A fixed gain keeps the level comparable. On a reSpeaker XVF3800
        8 let close speech (20..30 cm) reach 12,000..14,000 RMS and clip; 4 keeps
        wake-up at low volume and device-side barge-in. Re-sent at every boot.

config RESPEAKER_XVF3800_MIC_GAIN
    string "ReSpeaker: AUDIO_MGR_MIC_GAIN to write at boot (empty = leave the XMOS value)"
    depends on RESPEAKER_XVF3800_BARGE_IN || RESPEAKER_XVF3800_CONTROL_DIAGNOSTICS
    default ""
    help
        Linear gain applied to all four microphones before the XVF3800 AEC
        (resource 35, command 0; XMOS default 10, Seeed I2S firmware v1.0.4
        ships 90). With 90 a talker at normal distance already clips the
        processed output (full-scale samples in RESPEAKER_AUDIO_DIAGNOSTICS'
        rails16 count), which garbles transcription of close speech. The XMOS
        manual wants the microphone peaks about 6 dB below the reference.
        Re-sent at every boot.

config RESPEAKER_XVF3800_CONTROL_DIAGNOSTICS
    bool "ReSpeaker: log XVF3800 speech energy, DoA flag and AGC gain"
    depends on BOARD_TYPE_SEEED_XIAO_ESP32S3_RESPEAKER_XVF3800
    default n
    help
        Log the four AEC_SPENERGY_VALUES, the DOA_VALUE speech flag (Seeed I2S
        firmware v1.0.6 or later), PP_AGCGAIN and AEC_AECCONVERGED every
        200 ms while speaking and every 500 ms otherwise. Use it to calibrate
        RESPEAKER_XVF3800_BARGE_IN_THRESHOLD; leave disabled normally.

config RESPEAKER_XVF3800_CONTROL_POLL_MS
    int "ReSpeaker: XVF3800 control poll interval (ms)"
    depends on RESPEAKER_XVF3800_BARGE_IN || RESPEAKER_XVF3800_CONTROL_DIAGNOSTICS
    range 20 500
    default 50

choice XIAOZHI_NETWORK_TYPE
    prompt "Network Type"
    depends on BOARD_TYPE_WAVESHARE_ESP32_P4_NANO
    default XIAOZHI_NETWORK_WIFI
    help
        Select the network connection used by this board.

    config XIAOZHI_NETWORK_WIFI
        bool "WiFi"

    config XIAOZHI_NETWORK_ETHERNET
        bool "Ethernet"
        select ETH_ENABLED
        select ETH_USE_ESP32_EMAC
        help
            Use the onboard Ethernet port for network access.
endchoice

menu "Ethernet Configuration"
    depends on XIAOZHI_NETWORK_ETHERNET

    choice XIAOZHI_ETH_PHY_MODEL
        prompt "Ethernet PHY Device"
        default XIAOZHI_ETH_PHY_IP101

        config XIAOZHI_ETH_PHY_IP101
            bool "IP101/IP101GR"
            help
                IP101/IP101GR 10/100M Ethernet PHY, used by Waveshare ESP32-P4-NANO.
    endchoice

    config XIAOZHI_ETH_MDC_GPIO
        int "Ethernet SMI MDC GPIO"
        range 0 54
        default 31 if BOARD_TYPE_WAVESHARE_ESP32_P4_NANO
        default 31
        help
            GPIO used by the Ethernet SMI MDC signal.

    config XIAOZHI_ETH_MDIO_GPIO
        int "Ethernet SMI MDIO GPIO"
        range 0 54
        default 52 if BOARD_TYPE_WAVESHARE_ESP32_P4_NANO
        default 52
        help
            GPIO used by the Ethernet SMI MDIO signal.

    config XIAOZHI_ETH_PHY_ADDR
        int "Ethernet PHY Address"
        range -1 31
        default 1
        help
            Set the PHY address according to the board schematic.
            Use -1 to let the driver search for the PHY address.

    config XIAOZHI_ETH_PHY_RST_GPIO
        int "Ethernet PHY Reset GPIO"
        range -1 54
        default 51 if BOARD_TYPE_WAVESHARE_ESP32_P4_NANO
        default -1
        help
            GPIO used to reset the Ethernet PHY. Set to -1 if not connected.

endmenu

choice ESP32_S3_LCD_EV_BOARD_VERSION
